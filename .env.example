# Tinshed Crew Roster — environment configuration template
# Copy this file to `.env` and adjust values for your machine.
# `.env` is git-ignored and must never be committed (secrets live there, not here).
# All variables are optional; the application starts with the defaults below.

# Runtime environment: development | test | production
NODE_ENV=development

# TCP port the web server listens on (default 3000)
PORT=3000

# Where the SQLite database file is stored (default ./data/tinshed.db)
# Use an absolute path or `:memory:` for throwaway runs.
DB_PATH=./data/tinshed.db
